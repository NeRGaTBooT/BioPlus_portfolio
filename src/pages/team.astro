---

import BaseLayout from '../layouts/BaseLayout.astro';

import PageHeader from '../components/PageHeader.astro';

import { getTeamByDepartment } from '../utils/data';

import { withBase } from '../utils/paths';



const management = getTeamByDepartment('management');

const sales = getTeamByDepartment('sales');

---



<BaseLayout

  title="Наша команда"

  description="Руководство и отдел продаж ООО «БиоПлюс»."

>

  <PageHeader

    title="Наша команда"

    description="Квалифицированные специалисты помогут подобрать продукцию и оформить заказ."

  />



  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">

    <h2 class="text-base font-semibold text-[var(--color-foreground)]">Руководство</h2>

    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

      {

        management.map((member) => (

          <article class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-5 text-center">

            <img

              src={withBase(member.photo)}

              alt={member.name}

              width="120"

              height="120"

              class="mx-auto h-28 w-28 rounded-full object-cover bg-[var(--color-surface)]"

              loading="lazy"

            />

            <h3 class="mt-4 text-base font-semibold text-[var(--color-foreground)]">{member.name}</h3>

            <p class="mt-1 text-sm text-[var(--color-muted)]">{member.role}</p>

          </article>

        ))

      }

    </div>



    <h2 class="mt-12 text-base font-semibold text-[var(--color-foreground)]">Отдел продаж</h2>

    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

      {

        sales.map((member) => (

          <article class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-5 text-center">

            <img

              src={withBase(member.photo)}

              alt={member.name}

              width="96"

              height="96"

              class="mx-auto h-24 w-24 rounded-full object-cover bg-[var(--color-surface)]"

              loading="lazy"

            />

            <h3 class="mt-4 text-sm font-semibold text-[var(--color-foreground)]">{member.name}</h3>

            <p class="mt-1 text-xs text-[var(--color-muted)]">{member.role}</p>

          </article>

        ))

      }

    </div>

  </section>

</BaseLayout>

