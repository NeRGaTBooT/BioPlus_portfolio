---


import BaseLayout from '../layouts/BaseLayout.astro';

import PageHeader from '../components/PageHeader.astro';

import ContactForm from '../components/ContactForm.astro';

import { loadYaml } from '../utils/loadYaml';

import { getProductById } from '../utils/products';

import type { SiteConfig } from '../types/site';



const site = loadYaml<SiteConfig>('site.yaml');

const productId = Astro.url.searchParams.get('product') ?? undefined;

const product = productId ? getProductById(productId) : undefined;

---



<BaseLayout

  title="Контакты"

  description="Контактная информация, реквизиты и форма обратной связи ООО «БиоПлюс»."

>

  <PageHeader

    title="Контакты"

    description="Свяжитесь с нами по телефону, email или через форму обратной связи."

  />



  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">

    <div class="grid gap-10 lg:grid-cols-2">

      <div class="space-y-8">

        <div>

          <h2 class="text-base font-semibold text-[var(--color-foreground)]">Общие контакты</h2>

          <dl class="mt-4 space-y-3 text-sm">

            <div>

              <dt class="text-[var(--color-muted)]">Email</dt>

              <dd>

                <a href={`mailto:${site.contacts.email}`} class="font-medium">

                  {site.contacts.email}

                </a>

              </dd>

            </div>

            <div>

              <dt class="text-[var(--color-muted)]">Мобильный</dt>

              <dd class="font-medium text-[var(--color-foreground)]">

                <a href={`tel:${site.contacts.mobile}`} class="text-[var(--color-foreground)] no-underline hover:text-[var(--color-accent)]">

                  {site.contacts.mobile}

                </a>

                {' '}({site.contacts.mobileNote})

              </dd>

            </div>

          </dl>

        </div>



        {

          site.offices.map((office) => (

            <div>

              <h2 class="text-base font-semibold text-[var(--color-foreground)]">{office.name}</h2>

              <address class="mt-3 space-y-1 text-sm not-italic text-[var(--color-muted)]">

                <p>{office.address}</p>

                <p>{office.city}</p>

                {

                  office.phones.map((phone) => (

                    <p>

                      {phone.label}:{' '}

                      <a href={`tel:${phone.value.replace(/\s/g, '')}`} class="font-medium">

                        {phone.value}

                      </a>

                    </p>

                  ))

                }

                <p>{office.schedule}</p>

              </address>

              <div class="mt-4 overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)]">

                <iframe

                  src={office.mapEmbed}

                  title={`Карта: ${office.name}`}

                  width="100%"

                  height="220"

                  class="block border-0"

                  loading="lazy"

                  allowfullscreen

                />

              </div>

            </div>

          ))

        }

      </div>



      <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-6 sm:p-8">

        <h2 class="text-base font-semibold text-[var(--color-foreground)]">Форма обратной связи</h2>

        {

          product && (

            <p class="mt-2 text-sm text-[var(--color-muted)]">

              Запрос цены на: <span class="font-medium text-[var(--color-foreground)]">{product.name}</span>

            </p>

          )

        }

        <div class="mt-6">

          <ContactForm productId={productId} productName={product?.name} />

        </div>

      </div>

    </div>



    <div class="mt-12 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8">

      <h2 class="text-base font-semibold text-[var(--color-foreground)]">Реквизиты</h2>

      <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">

        <div>

          <dt class="text-[var(--color-muted)]">Юридическое лицо</dt>

          <dd class="mt-1 font-medium text-[var(--color-foreground)]">{site.requisites.legalName}</dd>

        </div>

        <div>

          <dt class="text-[var(--color-muted)]">УНП</dt>

          <dd class="mt-1 font-medium text-[var(--color-foreground)]">{site.requisites.unp}</dd>

        </div>

        <div>

          <dt class="text-[var(--color-muted)]">Юридический адрес</dt>

          <dd class="mt-1 text-[var(--color-foreground)]">{site.requisites.legalAddress}</dd>

        </div>

        <div>

          <dt class="text-[var(--color-muted)]">Почтовый адрес</dt>

          <dd class="mt-1 text-[var(--color-foreground)]">{site.requisites.postalAddress}</dd>

        </div>

        <div>

          <dt class="text-[var(--color-muted)]">Расчётный счёт</dt>

          <dd class="mt-1 font-mono text-xs text-[var(--color-foreground)]">{site.requisites.iban}</dd>

        </div>

        <div>

          <dt class="text-[var(--color-muted)]">Банк</dt>

          <dd class="mt-1 text-[var(--color-foreground)]">

            {site.requisites.bank}, BIC {site.requisites.bic}

          </dd>

        </div>

      </dl>

    </div>

  </section>

</BaseLayout>

