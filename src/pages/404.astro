---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---

<BaseLayout
  title="Страница не найдена"
  description="Запрашиваемая страница не существует. Вернитесь на главную или воспользуйтесь каталогом продукции."
>
  <section class="mx-auto flex max-w-6xl flex-col items-center px-4 py-24 text-center sm:px-6 lg:px-8">
    <p class="text-6xl font-bold text-[var(--color-accent)]">404</p>
    <h1 class="mt-4 text-2xl font-semibold text-[var(--color-foreground)]">
      Страница не найдена
    </h1>
    <p class="mt-3 max-w-md text-sm leading-relaxed text-[var(--color-muted)]">
      Возможно, ссылка устарела или страница была перемещена. Попробуйте поиск или
      вернитесь на главную.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={withBase('/')}
        class="inline-flex items-center rounded-[var(--radius-md)] bg-[var(--color-accent)] px-5 py-2.5 text-sm font-medium text-white no-underline hover:bg-[var(--color-accent-hover)] hover:text-white"
      >
        На главную
      </a>
      <a
        href={withBase('/products')}
        class="inline-flex items-center rounded-[var(--radius-md)] border border-[var(--color-border)] px-5 py-2.5 text-sm font-medium text-[var(--color-foreground)] no-underline hover:border-[var(--color-accent)]"
      >
        Каталог продукции
      </a>
    </div>
  </section>
</BaseLayout>
