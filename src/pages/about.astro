---

import BaseLayout from '../layouts/BaseLayout.astro';

import PageHeader from '../components/PageHeader.astro';

import { getEntry } from 'astro:content';

import { withBase } from '../utils/paths';

import '../styles/prose.css';



const entry = await getEntry('pages', 'about');

if (!entry) throw new Error('Page "about" not found');



const { Content } = await entry.render();

---



<BaseLayout title={entry.data.title} description={entry.data.description}>

  <PageHeader title={entry.data.title} description={entry.data.description} />



  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">

    <div class="grid gap-10 lg:grid-cols-5 lg:gap-12">

      <div class="prose-content lg:col-span-3">

        <Content />

      </div>

      <div class="lg:col-span-2">

        <div class="overflow-hidden rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)]">

          <img

            src={withBase('/images/about/building.svg')}

            alt="Офис ООО «БиоПлюс»"

            width="480"

            height="320"

            class="aspect-[3/2] w-full object-cover"

            loading="lazy"

          />

          <p class="px-4 py-3 text-xs text-[var(--color-muted)]">

            Офис компании в Минске

          </p>

        </div>

      </div>

    </div>

  </section>

</BaseLayout>

