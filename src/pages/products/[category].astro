---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import InStockFilter from '../../components/InStockFilter.astro';
import ProductCard from '../../components/ProductCard.astro';
import SubcategoryNav from '../../components/SubcategoryNav.astro';
import { getCategoryBySlug, getAllCategorySlugs } from '../../utils/categories';
import {
  countInStock,
  getProductsByCategory,
  getProductsBySubcategory,
} from '../../utils/products';
import { withBase } from '../../utils/paths';

export function getStaticPaths() {
  return getAllCategorySlugs().map((category) => ({ params: { category } }));
}

const { category: categorySlug } = Astro.params;
const category = getCategoryBySlug(categorySlug!);

if (!category) {
  return Astro.redirect(withBase('/products'));
}

const products = getProductsByCategory(category.id);
const inStockCount = countInStock(products);

const productsBySubcategory = category.subcategories.map((subcategory) => ({
  subcategory,
  products: getProductsBySubcategory(category.id, subcategory.id),
}));
---

<BaseLayout title={category.name} description={category.description}>
  <section class="border-b border-[var(--color-border)] bg-[var(--color-surface)]">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14 lg:px-8">
      <Breadcrumbs
        items={[
          { label: 'Главная', href: '/' },
          { label: 'Продукция', href: '/products' },
          { label: category.name },
        ]}
      />

      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-[var(--radius-lg)] bg-white">
          <img
            src={withBase(category.image)}
            alt=""
            width="40"
            height="40"
            class="h-10 w-10 object-contain"
            loading="lazy"
          />
        </div>
        <div>
          <h1 class="text-2xl font-semibold tracking-tight text-[var(--color-foreground)] sm:text-3xl">
            {category.name}
          </h1>
          <p class="mt-3 max-w-2xl text-base leading-relaxed text-[var(--color-muted)]">
            {category.description}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8" data-pagefind-body>
    <SubcategoryNav category={category} />

    <div class="mt-6">
      <InStockFilter total={products.length} inStock={inStockCount} />
    </div>

    {
      productsBySubcategory.map(({ subcategory, products: subcategoryProducts }) =>
        subcategoryProducts.length > 0 ? (
          <div class="mt-10">
            <div class="mb-4 flex items-center justify-between gap-4">
              <h2 class="text-base font-semibold text-[var(--color-foreground)]">
                {subcategory.name}
              </h2>
              <a
                href={withBase(`/products/${category.slug}/${subcategory.slug}`)}
                class="text-sm font-medium text-[var(--color-accent)] no-underline hover:text-[var(--color-accent-hover)]"
              >
                Все товары →
              </a>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {subcategoryProducts.map((product) => (
                <ProductCard product={product} />
              ))}
            </div>
          </div>
        ) : null,
      )
    }

    {
      products.length === 0 && (
        <p class="mt-10 text-center text-sm text-[var(--color-muted)]">
          В этой категории пока нет товаров.
        </p>
      )
    }
  </section>
</BaseLayout>
