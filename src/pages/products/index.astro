---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import CategoryGrid from '../../components/CategoryGrid.astro';
import { getCategories } from '../../utils/categories';
import { getAllProducts } from '../../utils/products';

const categories = getCategories();
const totalProducts = getAllProducts().length;
---

<BaseLayout
  title="Продукция"
  description="Каталог лабораторной продукции: реактивы, посуда, оборудование, мебель и хроматография."
>
  <PageHeader
    title="Продукция"
    description={`${totalProducts} наименований в каталоге. Выберите категорию для просмотра ассортимента.`}
  />

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8" data-pagefind-body>
    <CategoryGrid categories={categories} />
  </section>
</BaseLayout>
