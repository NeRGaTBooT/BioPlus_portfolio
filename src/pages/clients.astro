---

import BaseLayout from '../layouts/BaseLayout.astro';

import PageHeader from '../components/PageHeader.astro';

import LogoCard from '../components/LogoCard.astro';

import { getClients } from '../utils/data';



const clients = getClients();

---



<BaseLayout

  title="Основные клиенты"

  description="Предприятия и организации, которые доверяют ООО «БиоПлюс»."

>

  <PageHeader

    title="Основные клиенты"

    description="Среди наших клиентов — крупнейшие предприятия пищевой, химической и фармацевтической отраслей Беларуси."

  />



  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">

      {clients.map((client) => (

        <LogoCard name={client.name} logo={client.logo} url={client.url} />

      ))}

    </div>

  </section>

</BaseLayout>

