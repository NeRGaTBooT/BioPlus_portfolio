---
import type { Product } from '../types';
import { getCategoryById } from '../utils/categories';
import { withBase } from '../utils/paths';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const category = getCategoryById(product.category);
const subcategory = category?.subcategories.find((item) => item.id === product.subcategory);
---

<article
  class="flex flex-col rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-5"
  data-product-card
  data-in-stock={String(product.inStock)}
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-sm font-semibold leading-snug text-[var(--color-foreground)]">
      <a
        href={withBase(`/products/item/${product.id}`)}
        class="text-[var(--color-foreground)] no-underline hover:text-[var(--color-accent)]"
      >
        {product.name}
      </a>
    </h3>
    {
      product.inStock ? (
        <span class="shrink-0 rounded-full bg-[var(--color-accent-muted)] px-2 py-0.5 text-xs font-medium text-[var(--color-accent)]">
          В наличии
        </span>
      ) : (
        <span class="shrink-0 rounded-full bg-[var(--color-surface)] px-2 py-0.5 text-xs font-medium text-[var(--color-muted)]">
          Под заказ
        </span>
      )
    }
  </div>

  {
    subcategory && (
      <p class="mt-1 text-xs text-[var(--color-muted)]">{subcategory.name}</p>
    )
  }

  {
    product.manufacturer && (
      <p class="mt-2 text-xs text-[var(--color-muted)]">{product.manufacturer}</p>
    )
  }

  {
    product.description && (
      <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--color-muted)] line-clamp-2">
        {product.description}
      </p>
    )
  }

  <a
    href={withBase(`/contacts?product=${product.id}`)}
    class="mt-4 inline-flex text-sm font-medium text-[var(--color-accent)] no-underline hover:text-[var(--color-accent-hover)]"
  >
    Запросить цену →
  </a>
</article>
