---
interface Props {
  productId?: string;
  productName?: string;
}

const { productId, productName } = Astro.props;
const defaultMessage = productName
  ? `Прошу сообщить цену и наличие: ${productName}`
  : '';
---

<form id="contact-form" class="space-y-5" novalidate>
  {
    productId && (
      <input type="hidden" name="product" value={productId} />
    )
  }

  <div>
    <label for="contact-name" class="block text-sm font-medium text-[var(--color-foreground)]">
      Имя <span class="text-[var(--color-muted)]">*</span>
    </label>
    <input
      type="text"
      id="contact-name"
      name="name"
      required
      autocomplete="name"
      class="mt-1.5 w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white px-3 py-2.5 text-sm text-[var(--color-foreground)] outline-none focus:border-[var(--color-accent)]"
    />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-email" class="block text-sm font-medium text-[var(--color-foreground)]">
        Email <span class="text-[var(--color-muted)]">*</span>
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        autocomplete="email"
        class="mt-1.5 w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white px-3 py-2.5 text-sm text-[var(--color-foreground)] outline-none focus:border-[var(--color-accent)]"
      />
    </div>
    <div>
      <label for="contact-phone" class="block text-sm font-medium text-[var(--color-foreground)]">
        Телефон
      </label>
      <input
        type="tel"
        id="contact-phone"
        name="phone"
        autocomplete="tel"
        class="mt-1.5 w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white px-3 py-2.5 text-sm text-[var(--color-foreground)] outline-none focus:border-[var(--color-accent)]"
      />
    </div>
  </div>

  <div>
    <label for="contact-message" class="block text-sm font-medium text-[var(--color-foreground)]">
      Сообщение <span class="text-[var(--color-muted)]">*</span>
    </label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="4"
      class="mt-1.5 w-full resize-y rounded-[var(--radius-md)] border border-[var(--color-border)] bg-white px-3 py-2.5 text-sm text-[var(--color-foreground)] outline-none focus:border-[var(--color-accent)]"
    >{defaultMessage}</textarea>
  </div>

  <button
    type="submit"
    class="inline-flex items-center rounded-[var(--radius-md)] bg-[var(--color-accent)] px-5 py-2.5 text-sm font-medium text-white hover:bg-[var(--color-accent-hover)]"
  >
    Отправить заявку
  </button>
</form>

<div
  id="contact-toast"
  class="pointer-events-none fixed bottom-6 right-6 z-50 translate-y-4 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white px-5 py-4 text-sm font-medium text-[var(--color-foreground)] opacity-0 shadow-sm transition-all duration-300"
  role="status"
  aria-live="polite"
  hidden
>
  Заявка принята. Мы свяжемся с вами в ближайшее время.
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const toast = document.getElementById('contact-toast');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    if (!toast) return;

    toast.hidden = false;
    toast.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
    toast.classList.add('opacity-100', 'translate-y-0');

    window.setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      toast.classList.remove('opacity-100', 'translate-y-0');
      window.setTimeout(() => {
        toast.hidden = true;
      }, 300);
    }, 3000);

    form.reset();
  });
</script>
