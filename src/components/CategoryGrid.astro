---
import type { Category } from '../types';
import { withBase } from '../utils/paths';

interface Props {
  categories: Category[];
  columns?: 2 | 3;
}

const { categories, columns = 3 } = Astro.props;
const gridClass = columns === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---

<div class:list={['grid gap-4', gridClass]}>
  {
    categories.map((category) => (
      <a
        href={withBase(`/products/${category.slug}`)}
        class="group flex flex-col rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-white p-5 no-underline transition-colors hover:border-[var(--color-accent)] hover:bg-[var(--color-accent-muted)]"
      >
        <div class="aspect-[4/3] overflow-hidden rounded-[var(--radius-md)] bg-[var(--color-surface)]">
          <img
            src={withBase(category.image)}
            alt=""
            width="320"
            height="240"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
        <h3 class="mt-4 text-base font-semibold text-[var(--color-foreground)] group-hover:text-[var(--color-accent)]">
          {category.name}
        </h3>
        <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">
          {category.description}
        </p>
        <span class="mt-4 text-sm font-medium text-[var(--color-accent)]">
          Смотреть каталог →
        </span>
      </a>
    ))
  }
</div>
