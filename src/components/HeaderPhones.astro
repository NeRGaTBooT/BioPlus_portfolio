---
import type { SiteConfig } from '../types/site';

interface Props {
  site: SiteConfig;
  compact?: boolean;
}

const { site, compact = false } = Astro.props;

const cityNames: Record<string, string> = {
  minsk: 'Минск',
  gomel: 'Гомель',
};

function toTel(value: string): string {
  return value.replace(/[^\d+]/g, '');
}

function splitPhone(value: string): { prefix: string; main: string } {
  const match = value.match(/^(.+?)\s+([\d-]+)$/);
  if (match) return { prefix: `${match[1]} `, main: match[2] };
  return { prefix: '', main: value };
}

const officePhones = site.offices.map((office) => {
  const phone = office.phones[0];
  const parts = phone ? splitPhone(phone.value) : { prefix: '', main: '' };

  return {
    city: cityNames[office.id] ?? office.name,
    label: phone?.label ?? '',
    prefix: parts.prefix,
    main: parts.main,
    tel: phone ? toTel(phone.value) : '',
  };
});

const mobilePhone = {
  city: 'Мобильные',
  label: site.contacts.mobileNote,
  main: site.contacts.mobile,
  tel: site.contacts.mobile,
};
---

<div
  class:list={[
    'flex items-center',
    compact ? 'flex-col items-stretch gap-4' : 'gap-3 xl:gap-4',
  ]}
  role="group"
  aria-label="Контактные телефоны"
>
  {
    !compact && (
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-[var(--color-accent)] text-white"
        aria-hidden="true"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
          />
        </svg>
      </span>
    )
  }

  <div
    class:list={[
      'flex',
      compact ? 'flex-col gap-4' : 'items-start gap-4 xl:gap-6',
    ]}
  >
    {
      officePhones.map((phone) => (
        <div>
          <p class="text-[11px] font-semibold leading-tight text-[var(--color-foreground)]">
            {phone.city}
          </p>
          <p class="mt-0.5 text-xs leading-tight text-[var(--color-muted)]">{phone.label}</p>
          <a
            href={`tel:${phone.tel}`}
            class="mt-1 inline-block whitespace-nowrap text-sm leading-tight text-[var(--color-foreground)] no-underline hover:text-[var(--color-accent)]"
          >
            {phone.prefix && <span class="text-[var(--color-muted)]">{phone.prefix}</span>}
            <span class="font-semibold">{phone.main}</span>
          </a>
        </div>
      ))
    }

    <div>
      <p class="text-[11px] font-semibold leading-tight text-[var(--color-foreground)]">
        {mobilePhone.city}
      </p>
      <p class="mt-0.5 text-xs leading-tight text-[var(--color-muted)]">{mobilePhone.label}</p>
      <a
        href={`tel:${mobilePhone.tel}`}
        class="mt-1 inline-block whitespace-nowrap text-sm font-semibold leading-tight text-[var(--color-foreground)] no-underline hover:text-[var(--color-accent)]"
      >
        {mobilePhone.main}
      </a>
    </div>
  </div>
</div>
