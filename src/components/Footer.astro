---
import type { SiteConfig } from '../types/site';
import { withBase } from '../utils/paths';

interface Props {
  site: SiteConfig;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)]">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-sm font-semibold text-[var(--color-foreground)]">{site.name}</p>
        <p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">{site.tagline}</p>
        <dl class="mt-4 space-y-2 text-sm">
          <div>
            <dt class="sr-only">Email</dt>
            <dd>
              <a href={`mailto:${site.contacts.email}`} class="text-[var(--color-accent)]">
                {site.contacts.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="sr-only">Телефон</dt>
            <dd class="text-[var(--color-muted)]">
              {site.contacts.mobile} ({site.contacts.mobileNote})
            </dd>
          </div>
        </dl>
      </div>

      <div>
        <p class="text-sm font-semibold text-[var(--color-foreground)]">Продукция</p>
        <ul class="mt-3 space-y-2">
          {
            site.navigation.products.map((link) => (
              <li>
                <a href={withBase(link.href)} class="text-sm text-[var(--color-muted)] no-underline hover:text-[var(--color-accent)]">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold text-[var(--color-foreground)]">Компания</p>
        <ul class="mt-3 space-y-2">
          {
            site.navigation.about.map((link) => (
              <li>
                <a href={withBase(link.href)} class="text-sm text-[var(--color-muted)] no-underline hover:text-[var(--color-accent)]">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={withBase('/terms')} class="text-sm text-[var(--color-muted)] no-underline hover:text-[var(--color-accent)]">
              Условия работы
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="text-sm font-semibold text-[var(--color-foreground)]">Офисы</p>
        <ul class="mt-3 space-y-4">
          {
            site.offices.map((office) => (
              <li class="text-sm text-[var(--color-muted)]">
                <p class="font-medium text-[var(--color-foreground)]">{office.name}</p>
                <p class="mt-1">{office.address}</p>
                <p>{office.city}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-[var(--color-border)] pt-6 text-xs text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.requisites.legalName}. Все права защищены.</p>
      <p>УНП {site.requisites.unp}</p>
    </div>
  </div>
</footer>
