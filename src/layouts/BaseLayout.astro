---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchDialog from '../components/SearchDialog.astro';
import SEO from '../components/SEO.astro';
import { loadYaml } from '../utils/loadYaml';
import { withBase } from '../utils/paths';
import type { SiteConfig } from '../types/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const site = loadYaml<SiteConfig>('site.yaml');
const { title, description, image } = Astro.props;

const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const pageDescription = description ?? site.description;
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  description: site.description,
  email: site.contacts.email,
  url: Astro.site?.href,
  logo: new URL(withBase(site.logo), Astro.site).href,
  address: site.offices.map((office) => ({
    '@type': 'PostalAddress',
    streetAddress: office.address,
    addressLocality: office.city,
    addressCountry: 'BY',
  })),
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO title={pageTitle} description={pageDescription} image={image} />
    <link rel="icon" type="image/png" href={withBase(site.logo)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    <title>{pageTitle}</title>
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
  </head>
  <body class="flex min-h-screen flex-col bg-white">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-[var(--radius-md)] focus:bg-[var(--color-accent)] focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white focus:no-underline"
    >
      Перейти к содержимому
    </a>
    <Header site={site} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer site={site} />
    <SearchDialog />
  </body>
</html>

<style>
  body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
</style>
